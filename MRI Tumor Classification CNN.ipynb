   "source": [
    "# ========== User Input ==========\n",
    "print(\"🧠 MRI Tumor Classifier\")\n",
    "print(\"Type 'exit' to quit.\\n\")\n",
    "\n",
    "while True:\n",
    "    img_path = input(\"Enter path to MRI image: \").strip()\n",
    "    \n",
    "    if img_path.lower() in ['exit', 'quit']:\n",
    "        print(\"👋 Exiting classifier.\")\n",
    "        break\n",
    "\n",
    "    if not os.path.exists(img_path):\n",
    "        print(\"❌ Image file not found. Please try again.\\n\")\n",
    "        continue\n",
    "\n",
    "    try:\n",
    "        img = Image.open(img_path).convert(\"RGB\")\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Could not open image: {e}\")\n",
    "        continue\n",
    "\n",
    "    # ========== Preprocess and Prediction ==========\n",
    "    img_tensor = transform(img).unsqueeze(0).to(device)\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        output = model(img_tensor)\n",
    "        _, pred = torch.max(output, 1)\n",
    "        predicted_class = class_names[pred.item()]\n",
    "        print(f\"\\n✅ Prediction: **{predicted_class.upper()}**\\n\")"
   ]
