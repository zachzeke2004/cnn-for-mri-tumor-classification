   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Put model in evaluation mode\n",
    "model.eval()\n",
    "\n",
    "# Class labels\n",
    "class_names = train_dataset.classes\n",
    "\n",
    "# Fetch 20 test samples\n",
    "shown = 0\n",
    "max_show = 20\n",
    "\n",
    "fig = plt.figure(figsize=(15, 10))\n",
    "\n",
    "with torch.no_grad():\n",
    "    for images, labels in test_loader:\n",
    "        images = images.to(device)\n",
    "        outputs = model(images)\n",
    "        _, preds = torch.max(outputs, 1)\n",
    "\n",
    "        for i in range(images.size(0)):\n",
    "            if shown >= max_show:\n",
    "                break\n",
    "            ax = fig.add_subplot(4, 5, shown + 1)\n",
    "            img = images[i].cpu().permute(1, 2, 0)  # Convert from CHW to HWC\n",
    "            img = (img * 0.5) + 0.5  # Unnormalize\n",
    "\n",
    "            actual = class_names[labels[i]]\n",
    "            predicted = class_names[preds[i]]\n",
    "\n",
    "            color = 'green' if predicted == actual else 'red'\n",
    "            ax.imshow(img)\n",
    "            ax.set_title(f'PRED: {predicted}\\nTRUE: {actual}', color=color, fontsize=9)\n",
    "            ax.axis('off')\n",
    "            shown += 1\n",
    "        \n",
    "        if shown >= max_show:\n",
    "            break\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.suptitle('Model Predictions vs Actual Labels (20 Test Images)', fontsize=16)\n",
    "plt.subplots_adjust(top=0.90)\n",
    "plt.show()\n"
   ]
